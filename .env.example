# Supabase Configuration
# ─── Supabase (Frontend / Vite) ──────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── Supabase (Backend / Vercel serverless) ───────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# ⚠ SECRET — never commit this. Bypasses all Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Google OAuth ─────────────────────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id
VITE_GOOGLE_AUTH_PROXY=https://your-domain.com/auth/google/callback

# ─── Supabase Project Restore ─────────────────────────────────────────────────
FULLSTACK_PROJECT_REF=your-project-ref
FULLSTACK_RESTORE_API_URL=https://designarena.ai/api/fullstack-restore

# ─── Admin Access ─────────────────────────────────────────────────────────────
ADMIN_EMAILS=your-email@example.com
